APP_NAME = __APP__
APP_SLUG = __SLUG__
APP_BUNDLE_ID = __BUNDLE_ID__
APP_BUNDLE_ID_SUFFIX =
APP_BUNDLE_ID_SUFFIX[config=Debug] = .debug
APP_DISPLAY_NAME = $(APP_NAME)
APP_DISPLAY_NAME[config=Debug] = $(APP_NAME) Debug
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)

MACOSX_DEPLOYMENT_TARGET = __MACOS__
SWIFT_VERSION = 6.0

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

DEVELOPMENT_TEAM = __TEAM_ID__
APP_STORE_APP_ID =

