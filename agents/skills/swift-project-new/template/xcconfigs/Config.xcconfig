APP_NAME = __APP__
APP_SLUG = __SLUG__
APP_BUNDLE_ID = __BUNDLE_ID__
APP_BUNDLE_ID_SUFFIX =
APP_BUNDLE_ID_SUFFIX[config=Debug] = .debug
APP_DISPLAY_NAME = $(APP_NAME)
APP_DISPLAY_NAME[config=Debug] = $(APP_NAME) Debug
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)

MACOSX_DEPLOYMENT_TARGET = __MACOS__
SWIFT_VERSION = 6.0

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

DEVELOPMENT_TEAM = __TEAM_ID__
DEVELOPER_ID_CERTIFICATE = __DEVELOPER_ID_CERTIFICATE__
APP_STORE_APP_ID =

INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

APP_COPYRIGHT = Copyright © __YEAR__ __OWNER__. All rights reserved.

RELEASES_OWNER = __RELEASES_OWNER__
FEED_HOST = __FEED_HOST__
FEED_REPO = __FEED_REPO__
SPARKLE_FEED_URL = https:/$()/$(FEED_HOST)/apps/$(APP_SLUG)/appcast.xml
SPARKLE_PUBLIC_ED_KEY =

LEMON_SQUEEZY_STORE_ID = __LEMON_SQUEEZY_STORE_ID__
