{
  "version": "0.2",
  "language": "en-GB",
  "files": [
    "*.md",
    "docs/**/*.md",
    "appstore/**/*.{txt,md}",
    "appstore/metadata/**/*.json",
    "release-notes/**/*.md",
    "scripts/help.txt"
  ],
  "ignorePaths": [
    ".claude/**",
    "build.noindex/**",
    "**/.build/**"
  ],
  "words": [
    "__APP__",
    "__SLUG__",
    "Humor",
    "__CONTACT_LAST_NAME__",
    "__CONTACT_FIRST_NAME__",
    "tccutil",
    "lemonsqueezy",
    "actionlint",
    "appcast",
    "appstore",
    "codesign",
    "exiftool",
    "Gumroad",
    "lefthook",
    "memgraph",
    "noindex",
    "nonisolated",
    "notarytool",
    "spctl",
    "Squeezy",
    "storekit",
    "testflight",
    "tsan",
    "xcbeautify",
    "xcodeproj",
    "xctestplan",
    "yamllint",
    "zizmor"
  ],
  "caseSensitive": false,
  "ignoreRegExpList": [
    "/^```[\\s\\S]*?^```/gm",
    "/`[^`\\n]*`/g",
    "/\\b(asset|string) catalog\\b/gi",
    "/analyzer/gi",
    "/\\blint-analyze\\b/g"
  ],
  "flagWords": [
    "color",
    "colors",
    "colored",
    "center",
    "centers",
    "centered",
    "favor",
    "favorite",
    "favorites",
