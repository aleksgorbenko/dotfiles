{
  "workflows": [
    {
      "xcodeVersion": "Latest Release",
      "macOsVersion": "Latest Release",
      "replaces": ["Default"],
      "attributes": {
        "name": "Test macOS",
        "description": "Runs the {app} test plan on macOS for every push to main",
        "branchStartCondition": {
          "source": { "patterns": [{ "pattern": "main" }] },
          "autoCancel": true
        },
        "manualBranchStartCondition": {
          "source": { "isAllMatch": true }
        },
        "actions": [
          {
            "name": "{app} - macOS",
            "actionType": "TEST",
            "testConfiguration": {
              "kind": "SPECIFIC_TEST_PLANS",
              "testPlanName": "{app}",
              "testDestinations": [
                {
                  "deviceTypeName": "Mac",
                  "deviceTypeIdentifier": "mac",
                  "runtimeName": "Same As Selected macOS Version",
                  "runtimeIdentifier": "builder",
                  "kind": "MAC"
                }
              ]
            },
            "scheme": "{app}",
            "platform": "MACOS",
            "isRequiredToPass": true
          }
        ],
        "isEnabled": true,
        "clean": true,
        "containerFilePath": "{container}"
      }
    }
  ]
}
